# ==============================================================================
# Hostel Hub Global Configuration Environment Variables (Example Template)
# Copy this file to '.env' and populate with your credentials.
# ==============================================================================

# Database Settings
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hostel_complaint_db
DB_USER=root
DB_PASSWORD=your_database_password_here

# MySQL Service Container Settings
MYSQL_ROOT_PASSWORD=your_database_password_here
MYSQL_DATABASE=hostel_complaint_db
MYSQL_USER=hostel_user
MYSQL_PASSWORD=your_user_password_here

# SMTP Email Configuration (Gmail App Password)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password_here

# Google OAuth2 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Security Secret (Choose a long, random secure string)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# RabbitMQ Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Embedding Service Endpoint
EMBEDDING_SERVICE_URL=http://embedding-service:5000
